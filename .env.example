TELEGRAM_TOKEN=replace_with_bot_token
DATABASE_URL=sqlite:///marketobserver_v2.db
ADMIN_API_KEY=generate_a_long_random_admin_key
ADMIN_CHAT_IDS=123456789
DEFAULT_INTERVAL=1h
LIVE_PRICE_TTL_SECONDS=3
ALERT_POLL_SECONDS=60
SIGNAL_SCAN_SECONDS=900
NEWS_SCAN_SECONDS=900
CALENDAR_SCAN_SECONDS=60
# /binary entry mode: strict = all 8 gates required (default, safest);
# scored = enter when the 6 safety gates pass (score >= 6/8, graded strength).
# /backtest measures whichever mode is set, so compare them on real history.
BINARY_ENTRY_MODE=strict
PAPER_TRADING=true
MAX_RISK_PERCENT=2
MAX_POSITION_NOTIONAL=10000
ALLOW_LIVE_TRADING=false
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-5-mini
ZONEINFO_DEFAULT=Asia/Riyadh
