# تهيئة البوت ومحرك الذكاء الاصطناعي
bot = telebot.TeleBot(TELEGRAM_TOKEN)
client = genai.Client(api_key=GEMINI_API_KEY)

# تعليمات شخصية الخبير المالي
SYSTEM_PROMPT = """
أنت خبير ومحلل مالي ومستشار أسواق عالمية (Forex، ذهب، بيتكوين).
تتحدث بأسلوب احترافي، سلس، وشخصية خبير محترف ولطيف.

قواعد التعامل:
1. عند طلب التحليل أو السؤال عن الأسواق، قدم تحليلاً شاملاً وتوقع الاتجاهات والفرص.
2. إذا تعذر جلب الأرقام اللحظية، اعتمد على معرفتك العامة بآخر تحركات الأسواق (الذهب، EUR/USD، BTC) وحللها كخبير مالي بدون ذكر أي أعطال تقنية.
3. التفاعل مع المستخدم دائماً بأسلوب بشري جذاب واستخدام الإيموجي المناسب.
"""

FOREX_PAIRS = {
    "EURUSD=X": "EUR/USD (يورو / دولار)",
    "GBPUSD=X": "GBP/USD (باوند / دولار)",
    "USDJPY=X": "USD/JPY (دولار / ين)",
    "GC=F": "XAU/USD (الذهب)",
    "BTC-USD": "BTC/USD (البيتكوين)",
}


def generate_ai_response(prompt):
  """توليد الرد بالذكاء الاصطناعي مع تجربة عدة نماذج لتفادي أي خطأ"""
  available_models = [
      "gemini-2.0-flash",
      "gemini-1.5-flash",
      "gemini-2.0-flash-lite",
      "gemini-1.5-pro",
  ]

  for model_name in available_models:
    try:
      response = client.models.generate_content(
          model=model_name,
          contents=prompt,
          config=types.GenerateContentConfig(system_instruction=SYSTEM_PROMPT),
      )
      return response.text
    except Exception:
      continue

  return "عذراً، تعذر الاتصال بنماذج الذكاء الاصطناعي حالياً. يرجى المحاولة لاحقاً."


def calculate_rsi(series, period=14):
  """حساب مؤشر القوة النسبية RSI"""
  delta = series.diff()
  gain = (delta.where(delta > 0, 0)).fillna(0)
  loss = (-delta.where(delta < 0, 0)).fillna(0)
  avg_gain = gain.rolling(window=period).mean()
  avg_loss = loss.rolling(window=period).mean()
  rs = avg_gain / avg_loss
  return 100 - (100 / (1 + rs))


def fetch_market_data():
  """جلب أحدث أرقام ومؤشرات السوق"""
  summary_data = []
  for symbol, name in FOREX_PAIRS.items():
    try:
      ticker = yf.Ticker(symbol)
      df = ticker.history(period="1mo", interval="1d", timeout=5)
      if df is not None and len(df) >= 15:
        df["RSI"] = calculate_rsi(df["Close"])
        last_close = round(float(df["Close"].iloc[-1]), 4)
        last_rsi = round(float(df["RSI"].iloc[-1]), 1)
        summary_data.append(
            f"• {name}: السعر الحالي {last_close} | مؤشر RSI: {last_rsi}"
        )
    except Exception:
      pass

  if summary_data:
    return "\n".join(summary_data)
  else:
    return "ملاحظة: تعذر الوصول لخوادم الأسعار اللحظية، قم بتحليل اتجاهات السوق العامة بناءً على آخر التحديثات."


def generate_expert_report():
  """إعداد تقرير تحليلي كامل"""
  raw_data = fetch_market_data()
  prompt = f"بيانات وملاحظات السوق الحالية:\n{raw_data}\n\nاكتب تقرير تحليلي مالي شامل كخبير تداول (حلل الذهب، العملات، البيتكوين) مع ذكر الاتجاه والمتوقع بأسلوب جذاب."
  return generate_ai_response(prompt)


# --- أوامر وتفاعل البوت ---


@bot.message_handler(commands=["start", "help"])
def send_welcome(message):
  prompt = "رحب بالعميل كخبير مالي ومستشار أسواق ووضح له الأوامر المتاحة مثل /analyze."
  res = generate_ai_response(prompt)
  bot.reply_to(message, res)


@bot.message_handler(commands=["analyze"])
def handle_analyze(message):
  waiting_msg = bot.reply_to(
      message, "📈 أهلاً بك! جاري قراءة حركة الأسواق وإعداد التقرير..."
  )
  try:
    report = generate_expert_report()
    bot.edit_message_text(
        report, chat_id=message.chat.id, message_id=waiting_msg.message_id
    )
  except Exception:
    bot.send_message(
        message.chat.id, "حدث خطأ أثناء إعداد التقرير، أعد المحاولة."
    )@bot.message_handler(func=lambda msg: True)
def handle_chat(message):
  user_text = message.text
  bot.send_chat_action(message.chat.id, "typing")

  if any(
      w in user_text
      for w in ["تحليل", "السوق", "الذهب", "البيتكوين", "متى", "اين"]
  ):
    market_info = fetch_market_data()
    prompt = f"المستخدم يسأل: '{user_text}'. معطيات السوق الحالية: {market_info}. أجبه بأسلوب خبير مالي يتجاوب معه بذكاء."
  else:
    prompt = f"المستخدم يقول: '{user_text}'. رد عليه كخبير مالي بأسلوب تفاعلي ولطيف."

  res = generate_ai_response(prompt)
  bot.reply_to(message, res)


# --- جدولة التنبيهات الدورية والتشغيل ---


